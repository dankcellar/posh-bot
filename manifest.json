{
  "manifest_version": 3,
  "name": "Poshify",
  "short_name": "Poshify",
  "description": "Automatically share your entire Poshmark closet to followers or Posh Parties in one click — Follow Mode, Party Mode, zero hassle.",
  "version": "3.1",
  "icons": {
    "128": "public/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://poshmark.com/closet/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Poshify",
    "default_popup": "public/popup.html"
  },
  "permissions": ["declarativeContent", "tabs"]
}
